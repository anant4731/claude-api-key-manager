# Anthropic Admin API key. Generate at https://console.anthropic.com/settings/admin-keys
# Requires an organization (not an individual account).
ANTHROPIC_ADMIN_KEY=sk-ant-admin01-...

# 32-byte base64 secret used to encrypt stored Anthropic API keys at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Optional. Defaults to file:./.data/app.db
# DATABASE_URL=file:./.data/app.db

# Optional. Cheap model used to classify each proxied request as on/off-purpose.
# CLASSIFIER_MODEL=claude-haiku-4-5
