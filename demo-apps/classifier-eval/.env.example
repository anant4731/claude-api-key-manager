# The proxy token from Keymaster (starts with prx-)
ANTHROPIC_API_KEY=prx-...

# Local Keymaster proxy
ANTHROPIC_BASE_URL=http://localhost:4002/api/proxy

# Model to use when sending the test prompts (not the classifier's model).
# The classifier model itself is controlled by CLASSIFIER_MODEL in the app's env.
# ANTHROPIC_MODEL=claude-haiku-4-5
